# ─── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

# ─── Build output ──────────────────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ─── Environment ───────────────────────────────────────────────────────────
# Never commit real environment values. `.env.example` is the tracked template.
.env
.env.*
!.env.example

# ─── Logs ──────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Test and coverage output ──────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Caches ────────────────────────────────────────────────────────────────
.cache/
.eslintcache
.prettiercache

# ─── Local uploads and database artefacts ──────────────────────────────────
/uploads/
/backend/uploads/
*.sqlite
*.sqlite3
*.sql.gz
*.dump

# ─── Editors and IDEs ──────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS noise ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Local-only files ──────────────────────────────────────────────────────
*.local

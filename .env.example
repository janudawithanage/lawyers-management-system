# ═══════════════════════════════════════════════════════════════════════════
# SL-LMS — environment template
#
# Copy to `.env` at this directory (the repository root) and fill in every
# value. One file serves both packages: the API reads it through
# backend/src/config/env.js, and Vite reads it through `envDir` in
# frontend/vite.config.js.
#
# Nothing here is defaulted in code. A missing or malformed variable stops
# the API at boot and fails the frontend build, with the variable named.
# `.env` is git-ignored; this template is not. Keep the two in step.
#
# Every `change-me-…` value below is a placeholder that passes validation so
# that a fresh checkout builds. The API refuses to start with NODE_ENV
# =production while any secret still holds one.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Runtime ───────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# 5050 rather than 5000: on macOS the AirPlay Receiver in Control Centre
# already listens on 5000, which makes the API look broken rather than busy.
PORT=5050
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# ─── Database — MySQL 8, InnoDB ────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sl_lms
DB_USER=sl_lms
DB_PASSWORD=change-me-local-database-password
DB_POOL_SIZE=10

# ─── Identity — JWT access token plus rotating refresh token ───────────────
# Generate each secret with: openssl rand -base64 48
# Minimum 32 characters. Never reuse one secret for two purposes.
JWT_ACCESS_SECRET=change-me-0000000000000000000000000000000000
JWT_REFRESH_SECRET=change-me-1111111111111111111111111111111111
# Access token short and held in memory; refresh token in an httpOnly,
# Secure, SameSite=Strict cookie, rotated on use.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Security model specifies cost 12. Raising this slows every sign-in.
BCRYPT_COST=12

# ─── HTTP ──────────────────────────────────────────────────────────────────
# Comma-separated allow-list of bare origins. No wildcards, no trailing path.
CORS_ORIGINS=http://localhost:5173
COOKIE_SECRET=change-me-2222222222222222222222222222222222
# true only when running behind a TLS-terminating reverse proxy.
TRUST_PROXY=false

# ─── Document storage — S3-compatible, private bucket ──────────────────────
# Local development points at an object-storage emulator (MinIO).
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=sl-lms-documents
STORAGE_ACCESS_KEY_ID=change-me-storage-access-key
STORAGE_SECRET_ACCESS_KEY=change-me-3333333333333333333333333333333333
# Seconds a signed download URL stays valid. 30–3600.
STORAGE_SIGNED_URL_TTL=300

# ─── Transactional e-mail ──────────────────────────────────────────────────
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
MAIL_FROM=no-reply@sl-lms.lk

# ─── Frontend — exposed to the browser ─────────────────────────────────────
# Vite inlines every VITE_-prefixed value into the bundle at build time.
# Never put a secret here.
VITE_API_URL=http://localhost:5050/api/v1
VITE_APP_URL=http://localhost:5173
